<?xml version="1.0" encoding="utf-8"?>
<!--
  Install-time answer file for the Windows Server 2025 L1 base template.

  This is DIFFERENT from internal/provisioner/assets/windows-unattend.xml:
    * THIS file (autounattend.xml) automates the *OS install* of the L1 VM
      only. It is burned onto a small "answer ISO" mounted as a 2nd CD next
      to WindowsServer2025.iso, and Windows Setup reads it automatically from
      the ISO root during the windowsPE pass. It never travels to L2/L3.
    * windows-unattend.xml is the *sysprep* answer file that the Crucible
      wizard writes to C:\Windows\Panther\unattend.xml on every L2 generalize
      run; it creates the per-clone Student account. See templates/windows/
      SERVER-2025-SETUP.md and SETUP.md.

  End state produced by this file:
    * Windows Server 2025 Datacenter (Desktop Experience) installed on a
      clean UEFI/GPT 60 GB disk (Evaluation media — 180 day, rearmable).
    * Built-in Administrator enabled with a throwaway build password.
    * OOBE fully skipped; auto-logon once as Administrator to (a) set the
      built-in Administrator to never expire and (b) silently install VMware
      Tools from setup64.exe on the bundled answer/tools ISO (no internet). If
      Tools is not bundled, install it via vSphere per SERVER-2025-SETUP.md.
    * RDP enabled (NLA off) + firewall opened, purely for build-phase access.

  After the install completes and VMware Tools is running, the remaining L1
  prep (Windows Update, cloudbase-init, unattend placement, sysprep) is driven
  via `govc guest.run` per SERVER-2025-SETUP.md.

  Image name comes from the WIM inside WindowsServer2025.iso:
    Index 4 = "Windows Server 2025 SERVERDATACENTER"
             (Display: "Windows Server 2025 Datacenter Evaluation (Desktop Experience)")
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ============ windowsPE: locale, disk layout, image selection ============ -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <!-- Wipe disk 0 and lay down a standard UEFI/GPT layout:
           EFI system (260MB) + MSR (128MB) + Windows (rest). -->
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>260</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>128</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>FAT32</Format>
              <Label>System</Label>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <!-- Select the Datacenter (Desktop Experience) edition by WIM name so
               Setup never shows the "which edition" picker. -->
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows Server 2025 SERVERDATACENTER</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <FullName>Crucible Lab</FullName>
        <Organization>Crucible</Organization>
        <!-- Evaluation media has no product key. An empty ProductKey with
             WillShowUI=Never suppresses the product-key page. -->
        <ProductKey>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <!-- ============ specialize: hostname, timezone, RDP (build-phase only) ============ -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <ComputerName>WIN-WS2025-L1</ComputerName>
      <TimeZone>Eastern Standard Time</TimeZone>
      <RegisteredOrganization>Crucible</RegisteredOrganization>
      <RegisteredOwner>Crucible Lab</RegisteredOwner>
    </component>

    <!-- Enable RDP -->
    <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <fDenyTSConnections>false</fDenyTSConnections>
    </component>

    <!-- Open the Remote Desktop firewall group -->
    <component name="Networking-MPSSVC-Svc" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <FirewallGroups>
        <FirewallGroup wcm:action="add" wcm:keyValue="RemoteDesktop">
          <Active>true</Active>
          <Group>Remote Desktop</Group>
          <Profile>all</Profile>
        </FirewallGroup>
      </FirewallGroups>
    </component>

    <!-- Disable NLA so build-phase RDP works before creds are finalized -->
    <component name="Microsoft-Windows-TerminalServices-RDP-WinStationExtensions" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <UserAuthentication>0</UserAuthentication>
    </component>
  </settings>

  <!-- ============ oobeSystem: skip OOBE, set admin pw, install VMware Tools ============ -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <!-- Set the built-in Administrator password (throwaway build password;
           disabled again before sysprep per SERVER-2025-SETUP.md). -->
      <UserAccounts>
        <AdministratorPassword>
          <Value>REPLACE_WITH_BUILD_PASSWORD</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>

      <!-- One auto-logon as Administrator to run the VMware Tools install. -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>Administrator</Username>
        <Password>
          <Value>REPLACE_WITH_BUILD_PASSWORD</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>1</LogonCount>
      </AutoLogon>

      <FirstLogonCommands>
        <!-- Harden the throwaway build Administrator so an inactivity/maxpwage
             policy can never blank the password mid-build (this bit us once:
             govc guest auth started failing after the password silently
             expired). The final hardening also runs in SERVER-2025-SETUP.md
             via govc, but doing it here protects the whole build window. -->
        <SynchronousCommand wcm:order="1">
          <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Set-LocalUser -Name Administrator -PasswordNeverExpires $true; net accounts /maxpwage:unlimited"</CommandLine>
          <Description>Administrator password never expires (build safety)</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <!-- Install VMware Tools with NO internet. Scan drive letters D..L for
             the tools installer. The real filename on VMware's tools ISO is
             setup64.exe (NOT setup.exe) and it may sit at the ISO root OR under
             a bundled \vmtools\ folder. The silent syntax is `/S /v"/qn
             REBOOT=R"` with NO space between /v and the quote. If neither path
             is found (answer ISO built without Tools), install Tools manually
             via vSphere "Install VMware Tools" + reboot per SERVER-2025-SETUP.md
             step 2. The govc-driven prep cannot start until Tools is running. -->
        <SynchronousCommand wcm:order="2">
          <CommandLine>cmd /c "for %d in (D E F G H I J K L) do @(if exist %d:\vmtools\setup64.exe start /wait %d:\vmtools\setup64.exe /S /v"/qn REBOOT=R" &amp; if exist %d:\setup64.exe start /wait %d:\setup64.exe /S /v"/qn REBOOT=R")"</CommandLine>
          <Description>Install VMware Tools silently from answer/tools ISO</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>

    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64"
      publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
      xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
  </settings>

</unattend>
